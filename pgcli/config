# ~/.config/pgcli/config — symlinked from dotfiles/pgcli/config
#
# Full reference: https://github.com/dbcli/pgcli/blob/main/pgcli/pgclirc
# Restart pgcli after edits.

[main]

# Multi-line mode: hit Enter for newline, run with ; or ESC-Enter.
# Matches psql's behavior so muscle memory works.
multi_line = True
multi_line_mode = psql

# Smart completion: column names appear after SELECT/WHERE, table names after FROM, etc.
smart_completion = True
casing_file = default

# UPPERCASE SQL keywords as they're typed/completed.
keyword_casing = upper

# Auto-expand wide rows into vertical key/value layout (equivalent to psql's \x auto).
expand = auto
auto_expand = True

# Use pspg as the pager — tabular, scrollable, sortable result navigation.
# Theme 16 (Tao) is muted; cycle 0–20 to taste with F9 inside pspg.
pager = pspg -s 16 -X --no-mouse

# Table style for the rendered result before it hits the pager.
# Options: ascii, double, github, fancy_grid, grid, html, latex,
#          mediawiki, moinmoin, orgtbl, pipe, plain, psql, rst, simple, tsv, vertical
table_format = psql

# Render NULLs visibly so they don't blend with empty strings.
null_string = ∅

# Format-aware syntax highlighting. Try: monokai, native, friendly, vim, paraiso-dark
syntax_style = monokai

# Warn before destructive statements. Options: off / moderate / all
destructive_warning = all
destructive_warning_restarts_connection = False

# Always confirm before exiting when there's an open transaction.
destructive_statements_require_transaction = False

# Show row count and timing under each result.
show_bottom_status_bar = True
timing = True

# History: per-database files keep ↑ from pulling queries from the wrong DB.
history_file = ~/.config/pgcli/history
log_file = ~/.config/pgcli/log
log_level = WARNING

# Pull AUTOCOMMIT default from libpq (matches psql).
autocommit = True

# Enable vi keybindings — flip to True if you live in vim.
vi = False

# Asterisk expansion: typing SELECT * <tab> expands to the column list.
asterisk_expansion = True
qualified_columns = False
generate_aliases = False

# Search path / row limit safety net (0 = no limit).
row_limit = 1000

# Connection options
[alias_dsn]
# Define connection shortcuts here and use as:  pgcli -D <alias>
# Examples (uncomment & adjust):
# assured_local = postgres://localhost:5432/assured
# assured_staging = postgres://user:pass@staging-host:5432/assured

[named queries]
# Reusable queries — call from pgcli with `\n <name>`
# (pgcli equivalent of psql's `:name`)
conns = SELECT pid, usename, application_name, client_addr, state, wait_event_type, wait_event, age(now(), query_start) AS age, left(query, 80) AS query FROM pg_stat_activity WHERE pid <> pg_backend_pid() ORDER BY query_start DESC NULLS LAST;
locks = SELECT a.pid, a.usename, a.application_name, l.locktype, l.mode, l.granted, a.wait_event_type, a.wait_event, age(now(), a.query_start) AS age, left(a.query, 80) AS query FROM pg_locks l JOIN pg_stat_activity a USING (pid) WHERE NOT l.granted OR a.wait_event_type = 'Lock' ORDER BY a.query_start;
bigtables = SELECT schemaname, relname, pg_size_pretty(pg_total_relation_size(relid)) AS total, pg_size_pretty(pg_relation_size(relid)) AS heap, pg_size_pretty(pg_indexes_size(relid)) AS indexes FROM pg_catalog.pg_statio_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 20;
unusedidx = SELECT schemaname, relname AS table, indexrelname AS index, pg_size_pretty(pg_relation_size(indexrelid)) AS size FROM pg_stat_user_indexes WHERE idx_scan = 0 AND NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conindid = indexrelid) ORDER BY pg_relation_size(indexrelid) DESC;
slow = SELECT round(mean_exec_time::numeric, 2) AS mean_ms, calls, round(total_exec_time::numeric, 2) AS total_ms, left(query, 120) AS query FROM pg_stat_statements ORDER BY mean_exec_time DESC LIMIT 20;
cachehit = SELECT sum(heap_blks_hit)::float / NULLIF(sum(heap_blks_hit) + sum(heap_blks_read), 0) AS ratio FROM pg_statio_user_tables;

