# Ghostty Configuration

# Shell integration
shell-integration = zsh

# Scrollback buffer (1 million lines)
scrollback-limit = 1000000

# Restore window layout on restart
window-save-state = always

# Auto-copy selection to clipboard
copy-on-select = clipboard

# Reload config
keybind = cmd+shift+comma=reload_config

# Tab navigation (iTerm2-style)
keybind = cmd+left=previous_tab
keybind = cmd+right=next_tab

# Split management (iTerm2-style)
keybind = cmd+alt+right=new_split:right
keybind = cmd+alt+down=new_split:down
keybind = cmd+alt+up=new_split:up
keybind = cmd+alt+left=new_split:left

# Navigate between splits (directional)
keybind = cmd+shift+left=goto_split:left
keybind = cmd+shift+right=goto_split:right
keybind = cmd+shift+up=goto_split:up
keybind = cmd+shift+down=goto_split:down

# Cycle through splits (sequential)
keybind = cmd+]=goto_split:next
keybind = cmd+[=goto_split:previous

# Zoom current split (toggle fullscreen within tab)
keybind = cmd+shift+enter=toggle_split_zoom

# Equalize split sizes
keybind = cmd+shift+e=equalize_splits
