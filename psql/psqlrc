-- ~/.psqlrc — opinionated config for full-time CLI use
-- Symlinked from dotfiles/psql/psqlrc

-- Quiet startup so the banner doesn't dump settings every connect
\set QUIET 1

-- ── Output formatting ────────────────────────────────────────────────
\pset linestyle unicode      -- proper box-drawing chars instead of +---+
\pset border 2               -- full box around tables, not just separators
\pset null '∅'               -- make NULLs visually distinct from empty strings
\pset pager always           -- always page (pspg handles short results fine)
\pset format aligned

-- Auto-switch to vertical/expanded view when a row is too wide for the terminal.
-- Best-of-both-worlds: tables stay tabular until they wouldn't fit.
\x auto

-- ── Pager: pspg ──────────────────────────────────────────────────────
-- Theme 16 is the "Tao" theme — muted and readable. Try 0–20 to taste.
-- -X = no init/deinit (don't clear screen on exit)
-- --no-mouse lets terminal selection still work for copy/paste
-- -b = black background, drop if your terminal already handles it
\setenv PAGER 'pspg -s 16 -X --no-mouse'
\setenv LESS '-iMSx4 -FXR'

-- ── Query feedback ───────────────────────────────────────────────────
\timing on                    -- every query reports its execution time
\set VERBOSITY verbose        -- full error detail (sqlstate, hint, context)
\set ON_ERROR_ROLLBACK interactive  -- savepoint-per-statement in a tx, so a typo doesn't kill the whole transaction
\set COMP_KEYWORD_CASE upper  -- tab-complete SQL keywords as UPPERCASE

-- ── History ──────────────────────────────────────────────────────────
-- Per-database history files so muscle-memory ↑ doesn't pull queries from the wrong DB
\set HISTFILE ~/.psql_history- :DBNAME
\set HISTSIZE 5000
\set HISTCONTROL ignoredups

-- ── Prompt ───────────────────────────────────────────────────────────
-- Shows: user@db (tx-state)# — colored, with red when inside a transaction
-- %[ %] wrap non-printing chars so readline width calc stays correct
--   %033[1;33m = bold yellow for user@db
--   %033[1;31m = bold red, used inside %R (* = aborted tx, ! = active tx)
--   %033[0m    = reset
\set PROMPT1 '%[%033[1;33m%]%n@%/%[%033[1;31m%]%R%[%033[0m%]%# '
\set PROMPT2 '%[%033[1;33m%]%/%[%033[0m%]%R%# '

-- ── Handy named queries (call with `:name`) ─────────────────────────
-- :version       — server version
-- :extensions    — installed extensions
-- :conns         — current connections (who's connected, doing what)
-- :locks         — current locks, useful when something is blocked
-- :bigtables     — top 20 tables by total size (heap + indexes + toast)
-- :biggestidx    — top 20 indexes by size
-- :unusedidx     — indexes never scanned since stats reset (drop candidates)
-- :slow          — slowest queries by mean time (needs pg_stat_statements)
-- :tabstats      — row counts + sizes for tables in current schema
-- :cachehit      — cache hit ratio (>0.99 is healthy)

\set version 'SELECT version();'

\set extensions 'SELECT name, default_version, installed_version FROM pg_available_extensions WHERE installed_version IS NOT NULL ORDER BY name;'

\set conns 'SELECT pid, usename, application_name, client_addr, state, wait_event_type, wait_event, age(now(), query_start) AS age, left(query, 80) AS query FROM pg_stat_activity WHERE pid <> pg_backend_pid() ORDER BY query_start DESC NULLS LAST;'

\set locks 'SELECT a.pid, a.usename, a.application_name, l.locktype, l.mode, l.granted, a.wait_event_type, a.wait_event, age(now(), a.query_start) AS age, left(a.query, 80) AS query FROM pg_locks l JOIN pg_stat_activity a USING (pid) WHERE NOT l.granted OR a.wait_event_type = ''Lock'' ORDER BY a.query_start;'

\set bigtables 'SELECT schemaname, relname, pg_size_pretty(pg_total_relation_size(relid)) AS total, pg_size_pretty(pg_relation_size(relid)) AS heap, pg_size_pretty(pg_indexes_size(relid)) AS indexes FROM pg_catalog.pg_statio_user_tables ORDER BY pg_total_relation_size(relid) DESC LIMIT 20;'

\set biggestidx 'SELECT schemaname, relname AS table, indexrelname AS index, pg_size_pretty(pg_relation_size(indexrelid)) AS size, idx_scan FROM pg_stat_user_indexes ORDER BY pg_relation_size(indexrelid) DESC LIMIT 20;'

\set unusedidx 'SELECT schemaname, relname AS table, indexrelname AS index, pg_size_pretty(pg_relation_size(indexrelid)) AS size FROM pg_stat_user_indexes WHERE idx_scan = 0 AND NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conindid = indexrelid) ORDER BY pg_relation_size(indexrelid) DESC;'

\set slow 'SELECT round(mean_exec_time::numeric, 2) AS mean_ms, calls, round(total_exec_time::numeric, 2) AS total_ms, left(query, 120) AS query FROM pg_stat_statements ORDER BY mean_exec_time DESC LIMIT 20;'

\set tabstats 'SELECT relname, n_live_tup AS rows, pg_size_pretty(pg_total_relation_size(relid)) AS size, last_vacuum, last_autovacuum, last_analyze FROM pg_stat_user_tables ORDER BY n_live_tup DESC;'

\set cachehit 'SELECT sum(heap_blks_hit)::float / NULLIF(sum(heap_blks_hit) + sum(heap_blks_read), 0) AS ratio FROM pg_statio_user_tables;'

-- Re-enable normal verbosity now that setup is done
\unset QUIET
