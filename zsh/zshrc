# zshrc — interactive shell init.

# --- oh-my-zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""             # prompt comes from zplug → sindresorhus/pure
plugins=(git)
[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# --- zplug (plugins + pure prompt) ---
[ -f "$HOME/.zplug.sh" ] && source "$HOME/.zplug.sh"

# --- History ---
HISTFILE=~/.zsh_history
HISTSIZE=5000
SAVEHIST=5000
setopt APPEND_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS

DISABLE_AUTO_TITLE="true"

# --- Aliases ---
alias rzsh="source ~/.zshrc"
alias python="python3"
alias pip="python3 -m pip"
alias py="/opt/homebrew/bin/python3.12"
alias venv="source .venv/bin/activate"
alias pn="pnpm"
# Single-quoted so the $(...) is evaluated when the alias runs, not at shell startup.
alias drmi='docker rmi $(docker images -a -q)'
alias drmc='docker stop $(docker ps -a -q) && docker rm $(docker ps -a -q)'

# --- Completions ---
autoload -Uz compinit && compinit
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# --- Local overrides + secrets (gitignored, not in dotfiles repo) ---
[ -f "$HOME/.zshrc.local" ] && source "$HOME/.zshrc.local"
export PATH="$HOME/.local/bin:$PATH"
